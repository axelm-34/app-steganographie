<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="SteganographyApp.Views.DecodeView">

    <StackPanel Margin="20" Spacing="10">
        
        <TextBlock Text="Decode Message"
                   FontSize="24"
                   HorizontalAlignment="Center"/>

        <Button x:Name="SelectImageButton"
                Content="Choisir une image"
                Width="200"/>

        <TextBox x:Name="MessageTextBox"
                 AcceptsReturn="True"
                 Height="120"
                 IsReadOnly="True"/>

        <Button x:Name="DecodeButton"
                Content="Décoder"
                Width="120"
                HorizontalAlignment="Center"/>
                
        <TextBlock x:Name="StatusText" HorizontalAlignment="Center"/>
    </StackPanel>
</UserControl>