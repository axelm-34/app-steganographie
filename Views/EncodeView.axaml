<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="SteganographyApp.Views.EncodeView">

    <StackPanel Margin="20" Spacing="10">
        
        <TextBlock Text="Encode Message"
                   FontSize="24"
                   HorizontalAlignment="Center"/>

        <Button Content="Choisir une image"
                Width="200"/>

        <TextBox PlaceholderText="Entrez votre message"
                AcceptsReturn="True"
                Height="120"/>

        <Button Content="Encoder"
                Width="120"
                HorizontalAlignment="Center"/>
    </StackPanel>
</UserControl>