<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:SteganographyApp.Views"
    x:Class="SteganographyApp.Views.MainView">

    <TabControl>

        <TabItem Header="Encoder">
            <views:EncodeView />
        </TabItem>

        <TabItem Header="Décoder">
            <views:DecodeView />
        </TabItem>
    </TabControl>
</UserControl>
